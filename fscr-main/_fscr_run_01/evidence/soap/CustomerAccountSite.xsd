<?xml version="1.0" encoding="UTF-8" ?>
<xsd:schema elementFormDefault="qualified" targetNamespace="http://xmlns.oracle.com/apps/cdm/foundation/parties/customerAccountService/"
     sdoJava:package="oracle.apps.cdm.foundation.parties.customerAccountService" xmlns:ns0="http://xmlns.oracle.com/adf/svc/types/"
     xmlns:ns1="http://xmlns.oracle.com/apps/cdm/foundation/parties/partyService/" xmlns:ns2="http://xmlns.oracle.com/apps/cdm/foundation/parties/flex/custAccountSite/"
     xmlns:ns3="http://xmlns.oracle.com/apps/flex/cdm/foundation/parties/custAccountSiteGdf/"
     xmlns:sdo="commonj.sdo" xmlns:sdoJava="commonj.sdo/java" xmlns:sdoXML="commonj.sdo/xml"
     xmlns="http://xmlns.oracle.com/apps/cdm/foundation/parties/customerAccountService/"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <xsd:annotation>
        <xsd:documentation xmlns:oer="http://xmlns.oracle.com/oer">
            <name>Trading Community Customer Account Site</name>
            <description>An address associated with a customer account.</description>
            <oer:category name="lba">
                <value>CdmTop-Customer Data Management</value>
                <value>CdmTop-Customer Data Management : FoundationTop-Foundation</value>
                <value>CdmTop-Customer Data Management : FoundationTop-Foundation :
                    FoundationParties-Parties</value>
            </oer:category>
            <oer:attributes>
                <oer:attribute description="Customer site identifier." name="CustomerAccountSiteId"/>
                <oer:attribute description="Identifier for a customer account. Foreign key to the HZ_CUST_ACCOUNTS table"
                     name="CustomerAccountId"/>
                <oer:attribute description="Identifier for a party site. Foreign key to the HZ_PARTY_SITES table"
                     name="PartySiteId"/>
                <oer:attribute description="Who column: indicates the date and time of the last update of the row."
                     name="LastUpdateDate"/>
                <oer:attribute description="Who column: indicates the user who last updated the row."
                     name="LastUpdatedBy"/>
                <oer:attribute description="Who column: indicates the date and time of the creation of the row."
                     name="CreationDate"/>
                <oer:attribute description="Who column: indicates the user who created the row." name="CreatedBy"/>
                <oer:attribute description="Who column: indicates the session login associated to the user who last updated the row."
                     name="LastUpdateLogin"/>
                <oer:attribute description="Enterprise Service Scheduler: indicates the request ID of the job that created or last updated the row."
                     name="RequestId"/>
                <oer:attribute description="Address identifier from foreign system" name="OrigSystemReference"/>
                <oer:attribute description="Customer Status flag. Receivables lookup code for CODE_STATUS"
                     name="Status"/>
                <oer:attribute description="Indicates if this is a Bill-To site. Y for a Bill-To site, P for the primary Bill-To site, and N for a site that is not a Bill-To site."
                     name="BillToIndicator"/>
                <oer:attribute description="Indicates if this is a Marketing site. Y for a Marketing site, P for the primary Marketing site, and N for a site that is not a Marketing site."
                     name="MarketIndicator"/>
                <oer:attribute description="Indicates if this is a Ship-To site. Y for a Ship-To site, P for the primary Ship-To site, and N for a site that is not a Ship-To site."
                     name="ShipToIndicator"/>
                <oer:attribute description="User-definable category. The lookup type is ADDRESS_CATEGORY."
                     name="CustomerCategoryCode"/>
                <oer:attribute description="Operating Language for Acct Sites" name="Language"/>
                <oer:attribute description="Key account for sales representatives" name="KeyAccountFlag"/>
                <oer:attribute description="Trading partner header identifier" name="TpHeaderId"/>
                <oer:attribute description="Stores the EDI location code. It should be unique for a customer. The column accepts free-form text."
                     name="EceTpLocationCode"/>
                <oer:attribute description="Customer name in the language used at the account site."
                     name="TranslatedCustomerName"/>
                <oer:attribute description="TCA Who column" name="CreatedByModule"/>
                <oer:attribute description="Identifies a set of reference data shared across business units and other entities. Also known as Reference Data Sets, they are used to filter reference data in transactional UIs."
                     name="SetId"/>
                <oer:attribute description="Start date from which this site is valid for use." name="StartDate"/>
                <oer:attribute description="Date from which this site is no longer valid." name="EndDate"/>
                <oer:attribute description="Unique code to identify the reference data set for the account address."
                     name="SetCode"/>
                <oer:attribute description="Customer account contact associated with the account address."
                     name="CustomerAccountContact"/>
                <oer:attribute description="Customer account address use associated with the account address."
                     name="CustomerAccountSiteUse"/>
                <oer:attribute description="Identifier for this record from foreign or legacy system."
                     name="OriginalSystemReference"/>
                <oer:attribute description="Customer Account Address information." name="CustAcctSiteInformation"/>
                <oer:attribute description="Customer Account Address Regional Information" name="CustAccountSiteGdf"/>
            </oer:attributes>
        </xsd:documentation>
    </xsd:annotation>
    <xsd:import namespace="http://xmlns.oracle.com/adf/svc/types/" schemaLocation="https://fa-etia-test-saasfaprod1.fa.ocs.oraclecloud.com:443/crmService/CustomerAccountService?XSD=/META-INF/wsdl/BC4JService.xsd"/>
    <xsd:import namespace="http://xmlns.oracle.com/apps/cdm/foundation/parties/partyService/" schemaLocation="https://fa-etia-test-saasfaprod1.fa.ocs.oraclecloud.com:443/crmService/CustomerAccountService?XSD=/oracle/apps/cdm/foundation/parties/partyService/OriginalSystemReference.xsd"/>
    <xsd:import namespace="http://xmlns.oracle.com/apps/cdm/foundation/parties/flex/custAccountSite/"
         schemaLocation="https://fa-etia-test-saasfaprod1.fa.ocs.oraclecloud.com:443/crmService/CustomerAccountService?XSD=/oracle/apps/cdm/foundation/parties/flex/custAccountSite/CustAcctSiteInformation.xsd"/>
    <xsd:import namespace="http://xmlns.oracle.com/apps/flex/cdm/foundation/parties/custAccountSiteGdf/"
         schemaLocation="https://fa-etia-test-saasfaprod1.fa.ocs.oraclecloud.com:443/crmService/CustomerAccountService?XSD=/oracle/apps/flex/cdm/foundation/parties/custAccountSiteGdf/CustAccountSiteGdf.xsd"/>
    <xsd:import namespace="commonj.sdo/xml" schemaLocation="https://fa-etia-test-saasfaprod1.fa.ocs.oraclecloud.com:443/crmService/CustomerAccountService?XSD=/xml/sdoXML.xsd"/>
    <xsd:import namespace="commonj.sdo/java" schemaLocation="https://fa-etia-test-saasfaprod1.fa.ocs.oraclecloud.com:443/crmService/CustomerAccountService?XSD=/xml/sdoJava.xsd"/>
    <xsd:import namespace="commonj.sdo" schemaLocation="https://fa-etia-test-saasfaprod1.fa.ocs.oraclecloud.com:443/crmService/CustomerAccountService?XSD=/xml/sdoModel.xsd"/>
    <xsd:include schemaLocation="https://fa-etia-test-saasfaprod1.fa.ocs.oraclecloud.com:443/crmService/CustomerAccountService?XSD=/oracle/apps/cdm/foundation/parties/customerAccountService/CustomerAccountContact.xsd"/>
    <xsd:include schemaLocation="https://fa-etia-test-saasfaprod1.fa.ocs.oraclecloud.com:443/crmService/CustomerAccountService?XSD=/oracle/apps/cdm/foundation/parties/customerAccountService/CustomerAccountSiteUse.xsd"/>
    <xsd:complexType name="CustomerAccountSite">
        <xsd:annotation>
            <xsd:appinfo source="http://xmlns.oracle.com/adf/svc/metadata/">
                <key xmlns="http://xmlns.oracle.com/adf/svc/metadata/">
                    <attribute>CustomerAccountSiteId</attribute>
                </key>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element minOccurs="0" name="CustomerAccountSiteId" type="xsd:long" sdoXML:dataType="sdoJava:LongObject"/>
            <xsd:element minOccurs="0" name="CustomerAccountId" type="xsd:long" sdoXML:dataType="sdoJava:LongObject"/>
            <xsd:element minOccurs="0" name="PartySiteId" type="xsd:long" sdoXML:dataType="sdoJava:LongObject"/>
            <xsd:element minOccurs="0" name="LastUpdateDate" type="ns0:dateTime-Timestamp"/>
            <xsd:element minOccurs="0" name="LastUpdatedBy" type="xsd:string"/>
            <xsd:element minOccurs="0" name="CreationDate" type="ns0:dateTime-Timestamp"/>
            <xsd:element minOccurs="0" name="CreatedBy" type="xsd:string"/>
            <xsd:element minOccurs="0" name="LastUpdateLogin" nillable="true" type="xsd:string"/>
            <xsd:element minOccurs="0" name="RequestId" nillable="true" type="xsd:long"/>
            <xsd:element minOccurs="0" name="OrigSystemReference" type="xsd:string"/>
            <xsd:element minOccurs="0" name="Status" type="xsd:string"/>
            <xsd:element minOccurs="0" name="BillToIndicator" nillable="true" type="xsd:string"/>
            <xsd:element minOccurs="0" name="MarketIndicator" nillable="true" type="xsd:string"/>
            <xsd:element minOccurs="0" name="ShipToIndicator" nillable="true" type="xsd:string"/>
            <xsd:element minOccurs="0" name="CustomerCategoryCode" nillable="true" type="xsd:string"/>
            <xsd:element minOccurs="0" name="Language" nillable="true" type="xsd:string"/>
            <xsd:element minOccurs="0" name="KeyAccountFlag" nillable="true" type="xsd:boolean"/>
            <xsd:element minOccurs="0" name="TpHeaderId" nillable="true" type="xsd:long"/>
            <xsd:element minOccurs="0" name="EceTpLocationCode" nillable="true" type="xsd:string"/>
            <xsd:element minOccurs="0" name="TranslatedCustomerName" nillable="true" type="xsd:string"/>
            <xsd:element minOccurs="0" name="CreatedByModule" nillable="true" type="xsd:string"/>
            <xsd:element minOccurs="0" name="SetId" type="xsd:long" sdoXML:dataType="sdoJava:LongObject"/>
            <xsd:element minOccurs="0" name="StartDate" nillable="true" type="ns0:date-Date"/>
            <xsd:element minOccurs="0" name="EndDate" nillable="true" type="ns0:date-Date"/>
            <xsd:element minOccurs="0" name="SetCode" type="xsd:string"/>
            <xsd:element maxOccurs="unbounded" minOccurs="0" name="CustomerAccountContact" type="CustomerAccountContact"
                 sdoXML:dataType="sdo:DataObject"/>
            <xsd:element maxOccurs="unbounded" minOccurs="0" name="CustomerAccountSiteUse" type="CustomerAccountSiteUse"/>
            <xsd:element maxOccurs="unbounded" minOccurs="0" name="OriginalSystemReference" type="ns1:OriginalSystemReference"/>
            <xsd:element minOccurs="0" name="CustAcctSiteInformation" type="ns2:CustAcctSiteInformation"
                 sdoXML:dataType="sdo:DataObject"/>
            <xsd:element minOccurs="0" name="CustAccountSiteGdf" type="ns3:CustAccountSiteGdf" sdoXML:dataType="sdo:DataObject"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="customerAccountSite" type="CustomerAccountSite"/>
</xsd:schema>
