# Copy this file to .env (same folder) and fill in YOUR OWN values.
# Never share or commit .env.

# Oracle user name and password used by the scripts (REST calls)
ORACLE_USER=
ORACLE_PASS=

# Your Oracle pod address, e.g. https://your-pod.fa.ocs.oraclecloud.com
ORACLE_HOST=

# Label for this environment: dev, test, uat, sit, prod or your own
ORACLE_ENV=

# Only for production, and only if you really mean it (set it yourself):
# ALLOW_PROD=yes
