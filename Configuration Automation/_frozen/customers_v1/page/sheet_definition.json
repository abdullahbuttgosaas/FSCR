{
 "about": "The upload workbook: every tab and column. page/workbook.py reads uploads and makes the empty sheet from this file only. See the root CLAUDE.md > The upload sheet.",
 "version": 1,
 "layout": {"section_row": 1, "label_row": 2, "hint_row": 3, "first_data_row": 4, "template_rows": 497},
 "readme": {
  "tab": "Read me",
  "lines": [
   "Customer upload sheet: how to fill it",
   "",
   "Organization Customers = Oracle's Create Organization Customer screen. Person Customers = Create Person Customer screen.",
   "Same order and labels as Oracle, top to bottom. One row = one customer.",
   "Yellow headers (*) are required. Blue are optional; empty means Oracle's default.",
   "One customer per upload for now: fill only one customer row, on one of the two customer tabs.",
   "Address Purposes: one row per purpose. Customer Name = the customer's Name (organization) or First Name + space + Last Name (person).",
   "Not in the sheet (Oracle fills them): Registry ID, Account Number, Site Number, Site on a purpose.",
   "Dates are text, YYYY-MM-DD. Purpose dates must be within the address dates.",
   "Test environment only."
  ]
 },
 "column_sets": {
  "customer_account_and_address": [
   {"label": "Taxpayer Identification Number", "section": "@info", "key": "taxpayer_id", "type": "text"},
   {"label": "Account Description", "section": "Account Information", "key": "account_description", "type": "text"},
   {"label": "Account Type", "section": "Account Information", "key": "account_type", "type": "pick", "values": ["External", "Internal"], "live": "account_type"},
