   "columns": [
    {"label": "Customer Name", "section": "Address Purposes", "type": "text", "required": true, "hint": "Organization: its Name. Person: First Name + space + Last Name"},
    {"label": "Primary", "section": "Address Purposes", "key": "primary", "type": "yes-no", "default": false, "hint": "Yes / No. One Primary per purpose type. Oracle makes the first of each type Primary on save"},
    {"label": "Purpose", "section": "Address Purposes", "key": "purpose", "type": "pick", "required": true, "values": ["Acknowledgments", "Bill to", "Bills of lading", "Correspondence", "Credit contact", "Credit memos", "Deliver to", "Drawee", "Dunning", "Installed at", "Invoices", "Late charges", "Legal", "Self service user", "Ship to", "Sold to", "Statements", "Subscription Location"], "hint": "Dropdown, 18 values"},
    {"label": "From Date", "section": "Address Purposes", "key": "from_date", "type": "date", "role": "start", "default": "today", "hint": "YYYY-MM-DD, within the address dates; empty = today"},
