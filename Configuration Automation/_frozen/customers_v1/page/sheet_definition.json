   {"label": "Postal Code", "section": "Address", "key": "postal_code", "type": "text", "oracle_checks": true, "hint": "Must exist in Oracle"},
   {"label": "Responsible Mineral Status", "section": "Address", "key": "responsible_mineral_status", "type": "pick", "values": ["Conflict Free", "N/A", "No Data", "Undetermined"]},
   {"label": "Address", "section": "Address", "key": "address_note", "type": "text"},
   {"label": "URL", "section": "Address", "key": "url", "type": "text"},
   {"label": "ContactEmail", "section": "Address", "key": "contact_email", "type": "text"},
   {"label": "Authorizer", "section": "Address", "key": "authorizer", "type": "text"},
   {"label": "Supplier Site ID", "section": "Address", "key": "supplier_site_id", "type": "digits", "required": true, "hint": "Digits only, used as given"},
   {"label": "Sales Tax Geocode", "section": "Address", "key": "sales_tax_geocode", "type": "text"},
   {"label": "Sales Tax Inside City Limits", "section": "Address", "key": "sales_tax_inside_city_limits", "type": "yes-no", "default": true},
   {"label": "Customer Category Code", "section": "Address Details", "key": "customer_category_code", "type": "pick", "values": [], "check": false, "hint": "Dropdown (list empty in this Oracle)"},
   {"label": "Site Language", "section": "Address Details", "key": "site_language", "type": "text", "oracle_checks": true, "hint": "Dropdown"},
   {"label": "Translated Customer Name", "section": "Address Details", "key": "translated_customer_name", "type": "text"},
   {"label": "Key Account", "section": "Address Details", "key": "key_account", "type": "yes-no", "default": false},
   {"label": "Trading Partner Identifier", "section": "Address Details", "key": "trading_partner_identifier", "type": "digits", "hint": "Numbers only"},
   {"label": "EDI Location Code", "section": "Address Details", "key": "edi_location_code", "type": "text"}
  ]
 },
